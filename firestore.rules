            && d.status in ['rascunho','enviado','aprovado','recusado']
            && validText(d.notes,1000) && validText(d.validUntil,10)
            && d.createdAt is timestamp && d.updatedAt is timestamp;
        }
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
